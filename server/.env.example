# Copy to server/.env and fill in. Never commit the real file.
#
# GMAIL_APP_PASSWORD is a Google App Password (Google Account -> Security ->
# 2-Step Verification -> App passwords), not the account password. Spaces in
# the code Google shows you are for readability — strip them.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Where enquiries are delivered. Defaults to GMAIL_USER.
CONTACT_TO=

# Comma-separated list of origins allowed to post here. Required — the server
# refuses to start without it, and refuses "*" outright, because a wildcard
# lets any page on the internet send mail from your address.
#   local:      http://localhost:5173
#   production: https://your-domain.com
ALLOWED_ORIGINS=http://localhost:5173

# Optional. Only used to word the "Re: your message from ..." reply subject.
SITE_NAME=

PORT=8787
