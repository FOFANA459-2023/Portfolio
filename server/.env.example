# Copy to server/.env and fill in. Never commit the real file.
#
# GMAIL_APP_PASSWORD is a Google App Password (Google Account -> Security ->
# 2-Step Verification -> App passwords), not the account password. Spaces in
# the code Google shows you are for readability — strip them.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
CONTACT_TO=you@gmail.com
ALLOWED_ORIGIN=https://your-domain.com
PORT=8787
