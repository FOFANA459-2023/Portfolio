# ---------------------------------------------------------------------------
# The contact form has two delivery routes. Set ONE of these.
#
# Everything in this file is compiled into the public JavaScript bundle. Vite
# inlines every VITE_* value at build time, so nothing secret may live here.
# The Gmail app password lives in server/.env, which is server-side only.
# ---------------------------------------------------------------------------

# Route A — the mailer in server/. Sends from fvarlee@gmail.com using the
# template in server/email.mjs. Needs that Node process running and reachable;
# Gmail delivery is SMTP over a raw socket, which neither a browser nor an edge
# runtime can open. Local: http://localhost:8787/api/contact
VITE_CONTACT_ENDPOINT=

# Route B — Web3Forms. No server to run or maintain, but their template rather
# than ours. Generate a key at https://web3forms.com using fvarlee@gmail.com;
# mail is delivered to whichever address created the key. The key is a public
# identifier by design and is safe in the shipped bundle.
VITE_WEB3FORMS_KEY=

# Copy this file to .env.local for local development, AND set the same variable
# in the host's dashboard — a local-only file never reaches production.
